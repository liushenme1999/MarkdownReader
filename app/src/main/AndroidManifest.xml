<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MarkdownReaderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarkdownReader"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">
        <meta-data
            android:name="com.android.appcompat.app.APP_LOCALES_AUTO_STORE_LOCALES"
            android:value="true" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MarkdownReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 文件管理器 / 其他应用：用其他应用打开。
                 不按 MIME 枚举：实测同一批源码文件会被不同 ROM 报成 null / video/mp2ts /
                 application/rls-services+xml，任何白名单都会漏。这里收 */*，
                 真正的可读性由 BookImportSupport 按扩展名判定，误选会提示「不支持该格式」。 -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 分享到本应用 -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/ini" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/typescript" />
                <data android:mimeType="application/octet-stream" />
                <!-- 部分 ROM 把 .ts 报成 video/mp2ts、.rs 报成 rls-services+xml -->
                <data android:mimeType="video/mp2t" />
                <data android:mimeType="video/mp2ts" />
                <data android:mimeType="application/rls-services+xml" />
            </intent-filter>
        </activity>
    </application>

</manifest>
